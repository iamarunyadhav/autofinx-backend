# Add these values to the production backend .env before the transport deploy.
# Do not raise the event-lag limit to hide a slow websocket consumer.
AUTOFINX_RUNTIME_OWNER=supervisor
AUTOFINX_SUPERVISOR_RUNTIME=true
AUTOFINX_SCHEDULER_MARKET_CONSUMERS=false
AUTOFINX_MARKET_TRANSPORT_FLUSH_INTERVAL_MS=100
AUTOFINX_LIVE_QUOTE_WRITE_INTERVAL_MS=100
AUTOFINX_LIVE_OPEN_CANDLE_WRITE_INTERVAL_MS=1000
AUTOFINX_LIVE_FEED_SIDE_EFFECT_INTERVAL_MS=1000
AUTOFINX_LIVE_FEED_MAX_EVENT_LAG_MS=10000
