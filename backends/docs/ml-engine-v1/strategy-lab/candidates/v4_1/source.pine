//@version=6
// =====================================================================
//  AutoFinX TF-1 v2.1  |  Filtered Donchian trend (use on 4h or 1d)
//  v2.1 = v2 trading logic UNCHANGED + BUY/SELL/EXIT labels, position
//  shading and TradingView alert() notifications (not the AutoFinX webhook).
//
//  v2 adds (all pre-registered, keep them ALL ON for the main test):
//   - ADX above min and rising for 3 closed bars
//   - Choppiness below max for 3 closed bars
//   - ATR percentile above min (no breakouts in dead markets)
//   - Breakout distance >= 0.25 ATR beyond the channel
//   - Breakout bar volume above its rolling average
//   - Higher-timeframe direction agrees (repaint-safe, confirmed HTF bar)
//   - Failed-breakout exit: close back inside the channel within N bars
//   - Stats table: avg GROSS vs the 0.12% cost wall, net after an
//     ESTIMATED funding charge, profit factor, t-stat, trade count
//
//  Still NOT included on purpose:
//   - Real funding (Pine has no funding series): only an estimate in the table.
//   - Walk-forward: run the same frozen settings on several Start/End windows,
//     and do the real walk-forward in the Python pipeline.
//   - AutoFinX webhook: add only after out-of-sample + paper-forward pass.
//
//  Closed-bar signals, channel levels shifted [1], fills at the NEXT bar open.
//  Costs: 0.06% per side (fee 0.05 + slippage 0.01) = 0.12% round trip. 1x only.
// =====================================================================
strategy("AutoFinX TF-1 v2.1 | Filtered Donchian Trend", shorttitle = "AFX-TF1 v2.1", overlay = true,
     initial_capital = 10000,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.percent, commission_value = 0.06,
     slippage = 0, pyramiding = 0,
     calc_on_every_tick = false, process_orders_on_close = false,
     margin_long = 100, margin_short = 100,
     max_labels_count = 500)

// ── INPUTS ───────────────────────────────────────────────────────────
gE = "Entry"
donLen     = input.int(55, "Donchian entry length (bars)", minval = 10, maxval = 200, group = gE)
useTrend   = input.bool(true, "Only trade with the EMA trend", group = gE)
trendLen   = input.int(200, "Trend EMA length", minval = 20, maxval = 400, group = gE)
allowLong  = input.bool(true, "Allow longs", group = gE)
allowShort = input.bool(true, "Allow shorts", group = gE)

gF = "Filters (keep all ON for the main test)"
useAdx    = input.bool(true, "ADX above min and rising 3 bars", group = gF)
adxLen    = input.int(14, "ADX length", minval = 5, maxval = 50, group = gF)
adxMin    = input.float(20.0, "ADX min", minval = 5, maxval = 50, group = gF)
useChop   = input.bool(true, "Choppiness below max for 3 bars", group = gF)
chopLen   = input.int(14, "Choppiness length", minval = 5, maxval = 50, group = gF)
chopMax   = input.float(61.8, "Choppiness max", minval = 30, maxval = 90, group = gF)
useAtrPct = input.bool(true, "ATR percentile above min", group = gF)
atrPctLen = input.int(100, "ATR percentile lookback (bars)", minval = 20, maxval = 500, group = gF)
atrPctMin = input.float(40.0, "ATR percentile min", minval = 0, maxval = 100, group = gF)
useDist   = input.bool(true, "Breakout distance >= x ATR", group = gF)
distAtr   = input.float(0.25, "Breakout distance (x ATR)", minval = 0, maxval = 2, step = 0.05, group = gF)
useVol    = input.bool(true, "Breakout volume above average", group = gF)
volLen    = input.int(20, "Volume average length", minval = 5, maxval = 100, group = gF)
useHtf    = input.bool(true, "Higher timeframe direction agrees", group = gF)
htfTf     = input.timeframe("D", "HTF (D on a 4h chart, W on a 1d chart)", group = gF)
htfEmaLen = input.int(50, "HTF EMA length", minval = 10, maxval = 200, group = gF)

gX = "Exit"
exitLen  = input.int(20, "Donchian exit length (bars)", minval = 5, maxval = 100, group = gX)
atrLen   = input.int(14, "ATR length", minval = 5, maxval = 50, group = gX)
stopMult = input.float(2.0, "Hard stop (x ATR)", minval = 0.5, maxval = 6.0, step = 0.5, group = gX)
useFail  = input.bool(true, "Failed-breakout exit", group = gX)
failBars = input.int(3, "Failed-breakout window (bars after fill)", minval = 1, maxval = 20, group = gX)

gR = "Risk"
riskPct = input.float(1.0, "Risk per trade (% of equity)", minval = 0.1, maxval = 5.0, step = 0.1, group = gR,
     tooltip = "Position size = risk cash / stop distance, capped at 1x equity (no leverage).")

gC = "Cost report (table only)"
fund8h   = input.float(0.01, "Estimated funding per 8h held (%)", minval = 0, maxval = 0.2, step = 0.005, group = gC,
     tooltip = "Pine cannot book funding. This is charged on every trade in the table only, as a conservative estimate.")
costWall = input.float(0.12, "Round-trip cost wall (%)", minval = 0, maxval = 1, step = 0.01, group = gC)

gT = "Test window"
startT = input.time(timestamp("01 Oct 2021 00:00 +0000"), "Start", group = gT)
endT   = input.time(timestamp("01 Jan 2030 00:00 +0000"), "End",   group = gT)

gD = "Display"
showLabels = input.bool(true, "BUY / SELL / EXIT labels", group = gD)
shadePos   = input.bool(true, "Shade background while in a position", group = gD)

// ── INDICATORS (closed-bar values only) ──────────────────────────────
atr      = ta.atr(atrLen)
emaTrend = ta.ema(close, trendLen)
upper    = ta.highest(high, donLen)[1]
lower    = ta.lowest(low,  donLen)[1]
exitLo   = ta.lowest(low,  exitLen)[1]
exitHi   = ta.highest(high, exitLen)[1]

[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)
adxOk = not useAdx or (adx > adxMin and adx > adx[1] and adx[1] > adx[2] and adx[2] > adx[3])

chopRange = ta.highest(high, chopLen) - ta.lowest(low, chopLen)
chopSum   = math.sum(ta.tr(true), chopLen)
chop      = chopRange > 0 and chopSum > 0 ? 100.0 * math.log10(chopSum / chopRange) / math.log10(chopLen) : 100.0
chopOk    = not useChop or (chop < chopMax and chop[1] < chopMax and chop[2] < chopMax)

atrRank = ta.percentrank(atr, atrPctLen)
atrOk   = not useAtrPct or atrRank > atrPctMin

volAvg = ta.sma(volume, volLen)
volOk  = not useVol or (not na(volAvg) and volume > volAvg)

longDistOk  = not useDist or (close - upper) >= distAtr * atr
shortDistOk = not useDist or (lower - close) >= distAtr * atr

f_htfDir() =>
    e = ta.ema(close, htfEmaLen)
    close > e ? 1 : close < e ? -1 : 0
htfDir   = request.security(syminfo.tickerid, htfTf, f_htfDir()[1], barmerge.gaps_off, barmerge.lookahead_off)
htfValid = timeframe.in_seconds(htfTf) > timeframe.in_seconds(timeframe.period)
htfLongOk  = not useHtf or (htfValid and htfDir == 1)
htfShortOk = not useHtf or (htfValid and htfDir == -1)

// ── SIGNALS ──────────────────────────────────────────────────────────
inWindow  = time >= startT and time <= endT
baseLong  = close > upper and (not useTrend or close > emaTrend)
baseShort = close < lower and (not useTrend or close < emaTrend)
longSig   = inWindow and allowLong  and baseLong  and adxOk and chopOk and atrOk and volOk and longDistOk  and htfLongOk
shortSig  = inWindow and allowShort and baseShort and adxOk and chopOk and atrOk and volOk and shortDistOk and htfShortOk

f_reason(bool base, bool dist, bool htf) =>
    not base ? "NO_BREAKOUT" : not adxOk ? "ADX" : not chopOk ? "CHOP" : not atrOk ? "ATR_LOW" : not volOk ? "VOLUME" : not dist ? "WEAK_BREAK" : not htf ? "HTF" : "READY"

// Size so that a stop-out loses riskPct of equity, never more than 1x notional.
f_qty(float stopDist) =>
    float q = 0.0
    if not na(stopDist) and stopDist > 0 and close > 0
        q := math.min(strategy.equity * riskPct / 100.0 / stopDist, strategy.equity / close)
    q

var float stopLevel = na
var float brkLevel  = na
var int   entryBar  = na

// ── ENTRIES (signal on this bar's close, fill at next open) ──────────
if longSig and strategy.position_size <= 0
    float sd = stopMult * atr
    float q  = f_qty(sd)
    if q > 0
        stopLevel := close - sd
        brkLevel  := upper
        entryBar  := bar_index + 1
        strategy.entry("L", strategy.long, qty = q, comment = "Breakout")
        if showLabels
            label.new(bar_index, low, "BUY\n" + str.tostring(close, format.mintick) + "\nSL " + str.tostring(stopLevel, format.mintick), yloc = yloc.belowbar, style = label.style_label_up, color = color.new(color.green, 0), textcolor = color.white, size = size.small)
        alert("AFX v2.1 BUY " + syminfo.ticker + " " + timeframe.period + " close " + str.tostring(close, format.mintick) + " SL " + str.tostring(stopLevel, format.mintick) + " (fills next bar open)", alert.freq_once_per_bar_close)
        strategy.exit("L-stop", from_entry = "L", stop = stopLevel)

if shortSig and strategy.position_size >= 0
    float sd = stopMult * atr
    float q  = f_qty(sd)
    if q > 0
        stopLevel := close + sd
        brkLevel  := lower
        entryBar  := bar_index + 1
        strategy.entry("S", strategy.short, qty = q, comment = "Breakout")
        if showLabels
            label.new(bar_index, high, "SELL\n" + str.tostring(close, format.mintick) + "\nSL " + str.tostring(stopLevel, format.mintick), yloc = yloc.abovebar, style = label.style_label_down, color = color.new(color.red, 0), textcolor = color.white, size = size.small)
        alert("AFX v2.1 SELL " + syminfo.ticker + " " + timeframe.period + " close " + str.tostring(close, format.mintick) + " SL " + str.tostring(stopLevel, format.mintick) + " (fills next bar open)", alert.freq_once_per_bar_close)
        strategy.exit("S-stop", from_entry = "S", stop = stopLevel)

// ── EXITS ────────────────────────────────────────────────────────────
inFailWindow = not na(entryBar) and bar_index - entryBar < failBars

if strategy.position_size > 0
    strategy.exit("L-stop", from_entry = "L", stop = stopLevel)
    if useFail and inFailWindow and close < brkLevel
        strategy.close("L", comment = "FailedBreak")
    else if close < exitLo
        strategy.close("L", comment = "ChanExit")

if strategy.position_size < 0
    strategy.exit("S-stop", from_entry = "S", stop = stopLevel)
    if useFail and inFailWindow and close > brkLevel
        strategy.close("S", comment = "FailedBreak")
    else if close > exitHi
        strategy.close("S", comment = "ChanExit")

if time > endT
    strategy.close_all(comment = "WindowEnd")

// ── EXIT LABELS (read the trade that just closed: stop, failed breakout, channel) ──
var int seenClosed = 0
if strategy.closedtrades > seenClosed
    int k = strategy.closedtrades - 1
    string why = strategy.closedtrades.exit_comment(k)
    if na(why) or why == ""
        why := strategy.closedtrades.exit_id(k)
    float ntl = math.abs(strategy.closedtrades.size(k)) * strategy.closedtrades.entry_price(k)
    float pnlPct = ntl > 0 ? strategy.closedtrades.profit(k) / ntl * 100.0 : 0.0
    bool wasLong = strategy.closedtrades.size(k) > 0
    if showLabels
        label.new(bar_index, wasLong ? high : low, "EXIT " + why + "\n" + str.tostring(pnlPct, "#.##") + "%", yloc = wasLong ? yloc.abovebar : yloc.belowbar, style = wasLong ? label.style_label_down : label.style_label_up, color = pnlPct >= 0 ? color.new(color.teal, 10) : color.new(color.gray, 10), textcolor = color.white, size = size.tiny)
    alert("AFX v2.1 EXIT " + syminfo.ticker + " " + why + " " + str.tostring(pnlPct, "#.##") + "%", alert.freq_once_per_bar_close)
    seenClosed := strategy.closedtrades

// ── VISUALS ──────────────────────────────────────────────────────────
bgcolor(shadePos and strategy.position_size > 0 ? color.new(color.green, 92) : shadePos and strategy.position_size < 0 ? color.new(color.red, 92) : na, title = "In position")
plot(upper,    "Entry high", color = color.new(color.lime, 40))
plot(lower,    "Entry low",  color = color.new(color.red, 40))
plot(exitLo,   "Exit low",   color = color.new(color.orange, 70), style = plot.style_stepline)
plot(exitHi,   "Exit high",  color = color.new(color.orange, 70), style = plot.style_stepline)
plot(emaTrend, "Trend EMA",  color = color.new(color.blue, 30), linewidth = 2)
plot(strategy.position_size != 0 ? stopLevel : na, "Stop", color = color.new(color.fuchsia, 20), style = plot.style_circles)
plotshape(longSig  and strategy.position_size <= 0, "Long",  style = shape.triangleup,   location = location.belowbar, color = color.lime, size = size.small)
plotshape(shortSig and strategy.position_size >= 0, "Short", style = shape.triangledown, location = location.abovebar, color = color.red,  size = size.small)
plot(adx,     "dbg_adx",     display = display.data_window)
plot(chop,    "dbg_chop",    display = display.data_window)
plot(atrRank, "dbg_atrRank", display = display.data_window)

// ── STATS TABLE (gross vs cost wall, net after estimated funding) ────
var table st = table.new(position.bottom_right, 2, 12, border_width = 1)

f_row(int r, string k, string v, color bg) =>
    table.cell(st, 0, r, k, text_color = color.white, bgcolor = bg, text_size = size.small)
    table.cell(st, 1, r, v, text_color = color.white, bgcolor = bg, text_size = size.small)

f_pf(bool ok) => ok ? color.new(color.green, 35) : color.new(color.red, 35)

if barstate.islast
    int   n     = strategy.closedtrades
    int   m     = 0
    float sumG  = 0.0
    float sumN  = 0.0
    float sumN2 = 0.0
    float gp    = 0.0
    float gl    = 0.0
    if n > 0
        for i = 0 to n - 1
            float notional = math.abs(strategy.closedtrades.size(i)) * strategy.closedtrades.entry_price(i)
            if notional > 0
                float net   = strategy.closedtrades.profit(i)
                float gross = net + strategy.closedtrades.commission(i)
                float hrs   = (strategy.closedtrades.exit_time(i) - strategy.closedtrades.entry_time(i)) / 3600000.0
                float fund  = notional * fund8h / 100.0 * hrs / 8.0
                float netF  = net - fund
                float pct   = netF / notional * 100.0
                sumG  += gross / notional * 100.0
                sumN  += pct
                sumN2 += pct * pct
                m     += 1
                if netF > 0
                    gp += netF
                else
                    gl -= netF
    float avgG  = m > 0 ? sumG / m : na
    float avgN  = m > 0 ? sumN / m : na
    float sdN   = m > 1 ? math.sqrt(math.max(0.0, (sumN2 - m * avgN * avgN) / (m - 1))) : na
    float tStat = not na(sdN) and sdN > 0 ? avgN / (sdN / math.sqrt(m)) : na
    float pf    = gl > 0 ? gp / gl : na
    color grey  = color.new(color.gray, 25)
    string sig  = longSig ? "BUY" : shortSig ? "SELL" : "WAIT"

    f_row(0,  "Now",                  sig, sig == "WAIT" ? grey : sig == "BUY" ? color.new(color.green, 20) : color.new(color.red, 20))
    f_row(1,  "Long block",           f_reason(baseLong,  longDistOk,  htfLongOk),  grey)
    f_row(2,  "Short block",          f_reason(baseShort, shortDistOk, htfShortOk), grey)
    f_row(3,  "HTF setting",          htfValid ? "OK" : "HTF must be above chart TF", htfValid ? grey : color.new(color.red, 35))
    f_row(4,  "Trades (need 100+)",   str.tostring(m), f_pf(m >= 100))
    f_row(5,  "Avg GROSS / trade",    na(avgG) ? "-" : str.tostring(avgG, "#.###") + "%  (wall " + str.tostring(costWall, "#.##") + "%)", f_pf(avgG > costWall))
    f_row(6,  "Avg NET / trade*",     na(avgN) ? "-" : str.tostring(avgN, "#.###") + "%", f_pf(avgN > 0))
    f_row(7,  "Profit factor* (>1.15)", na(pf) ? "-" : str.tostring(pf, "#.##"), f_pf(pf > 1.15))
    f_row(8,  "t-stat* (>2)",         na(tStat) ? "-" : str.tostring(tStat, "#.##"), f_pf(tStat > 2.0))
    f_row(9,  "Max drawdown",         str.tostring(strategy.max_drawdown, "#.##"), grey)
    f_row(10, "Costs",                "0.06%/side, 1x", grey)
    f_row(11, "* after est. funding", str.tostring(fund8h, "#.###") + "% per 8h", color.new(color.orange, 40))
