# Exchange adapters
EXCHANGE_DEFAULT=binance
# BINANCE_ENABLED only gates the legacy Adapters/BinanceAdapter.php spot
# adapter (paired with LIVE_TRADING_ENABLED above) — it does not gate Ratio
# Bot, Future Trade, Fast2X, or Robot Trade's own Binance usage.
BINANCE_ENABLED=false
BINANCE_API_KEY=
BINANCE_API_SECRET=
# BINANCE_API_URL is the only key actually read (config/services.php ->
# services.binance.api_url / services.binance.base_url). A separate
# BINANCE_BASE_URL key used to exist here and was read raw via env() in
# BinanceAdapter.php, bypassing `php artisan config:cache` — removed; do not
# reintroduce it.
BINANCE_API_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443
BINANCE_TESTNET_API_URL=https://testnet.binance.vision
BINANCE_TESTNET_WS_URL=wss://testnet.binance.vision
BINANCE_FUTURES_API_URL=https://fapi.binance.com
BINANCE_FUTURES_WS_URL=wss://fstream.binance.com
# Lane-specific futures public-market-data endpoints (2026-09-22 transport
# hotfix) -- public carries depth*, market carries kline_*. Do not repoint
# BINANCE_FUTURES_WS_URL above to either of these; other consumers (private
# user-stream services) still need the plain root host unchanged.
BINANCE_FUTURES_PUBLIC_WS_URL=wss://fstream.binance.com/public
BINANCE_FUTURES_MARKET_WS_URL=wss://fstream.binance.com/market
BINANCE_FUTURES_WS_API_URL=wss://ws-fapi.binance.com/ws-fapi/v1
BINANCE_FUTURES_TESTNET_API_URL=https://testnet.binancefuture.com
BINANCE_FUTURES_TESTNET_WS_URL=wss://stream.binancefuture.com
BINANCE_FUTURES_TESTNET_WS_API_URL=wss://testnet.binancefuture.com/ws-fapi/v1
