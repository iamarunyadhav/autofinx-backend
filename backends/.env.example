# Fast2X micro scalping bot
# BINANCE_TESTNET is not read anywhere in this codebase — removed. Fast2X's
# real testnet/live switch is PAPER_TRADING + ENABLE_LIVE_TRADING below.
PAPER_TRADING=true
# ENABLE_LIVE_TRADING gates Fast2X only (config/fast2x.php). It is NOT the
# same switch as LIVE_TRADING_ENABLED (legacy spot) or
# FUTURE_TRADE_ENABLE_LIVE_TRADING (Future Trade) — see "Live trading safe
# mode" above.
ENABLE_LIVE_TRADING=false
FAST2X_DEFAULT_SYMBOL=BTCUSDT
FAST2X_MAX_LATENCY_MS=500
FAST2X_POLLING_INTERVAL_MS=1000
FAST2X_WEBSOCKET_RETRY_SECONDS=30
FAST2X_MAX_TRADES_PER_DAY=50
FAST2X_MAX_DAILY_LOSS_PERCENT=3
# Seconds fast2x_states.last_heartbeat_at may go stale before fast2x:supervise
# (scheduled every minute, routes/console.php) restarts that workspace's
# fast2x:run daemon. See app/Console/Commands/Fast2XSuperviseCommand.php.
FAST2X_SUPERVISOR_STALE_SECONDS=90
# Leave blank to auto-detect (PHP_BINARY, then common cPanel ea-phpXX paths).
FAST2X_PHP_BINARY=

# Future Trade Bot - futures scanner/execution
FUTURE_TRADE_PAPER_TRADING=true
FUTURE_TRADE_ENABLE_TESTNET_TRADING=false
# FUTURE_TRADE_ENABLE_LIVE_TRADING gates Future Trade only. It is NOT the
# same switch as LIVE_TRADING_ENABLED (legacy spot) or ENABLE_LIVE_TRADING
# (Fast2X) — see "Live trading safe mode" above. As of the 2026-09-02 audit
# fix, this server-level flag is AND-ed with the per-workspace DB flag in
# FutureTradeBotService::environmentTradingEnabled() — both must be true for
# live trading to proceed, so setting this to false here is a real global
# block regardless of what any individual workspace has configured.
FUTURE_TRADE_ENABLE_LIVE_TRADING=false
FUTURE_TRADE_FORCE_TESTNET=true
FUTURE_TRADE_DEFAULT_SIGNAL_PROFILE=autofinx_prime_v6_1_7_crypto
FUTURE_TRADE_SIGNAL_PROFILE=autofinx_prime_v6_1_7_crypto
FUTURE_TRADE_SIGNAL_SOURCE=webhook
FUTURE_TRADE_PHP_BINARY=
FUTURE_TRADE_PINE_WEBHOOK_TOKEN=
# TradingView sends alerts to /api/v1/future-trade/pine-webhook/{workspace}.
# Prefer a per-workspace rotated token; keep this global token only for migration compatibility.
FUTURE_TRADE_ALLOW_GLOBAL_WEBHOOK_TOKEN_FALLBACK=true
FUTURE_TRADE_PRIME_MIRROR_EXECUTION_ENABLED=false
FUTURE_TRADE_PRIME_MIRROR_LIVE_ENABLED=false
FUTURE_TRADE_PINE_WEBHOOK_LIVE_ENABLED=true

# Audit Research observability subsystem (Ratio Bot). When false,
# AuditEventRecorder::record() is a true no-op before any DB work — safe to
# flip off without affecting Ratio Bot's own trading behavior.
AUDIT_RESEARCH_ENABLED=true
FUTURE_TRADE_PERMISSIVE_SYMBOL_MODE=true
FUTURE_TRADE_PINE_WEBHOOK_FALLBACK_TIMEOUT_SECONDS=1200

# Per-asset toggles
ASSET_GLOBAL_ENABLED=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Nexus research: install migrations and isolated workers before enabling.
# Production rollout: scripts/nexus-production-setup.sh (docs/NEXUS_PRODUCTION_SETUP.md).
# Autonomy (agent/AUTONOMY_POLICY.md): 0 = local observations + reports only (Phase 0),
# 1 = + registered public sources / candidate proposals, 2 = + operator-queued experiments.
# Values above 2 grant nothing. The LLM path also needs AUTOFINX_NEXUS_LLM_ENABLED=true + url/key.
AUTOFINX_NEXUS_ENABLED=false
AUTOFINX_NEXUS_AUTONOMY_LEVEL=2
AUTOFINX_NEXUS_QUEUE_CONNECTION=nexus
AUTOFINX_NEXUS_LLM_ENABLED=false
AUTOFINX_NEXUS_LLM_PROVIDER=openai-compatible
AUTOFINX_NEXUS_LLM_URL=
AUTOFINX_NEXUS_LLM_API_KEY=
AUTOFINX_NEXUS_ROUTINE_MODEL=
AUTOFINX_NEXUS_DEEP_MODEL=
AUTOFINX_NEXUS_MAX_CALLS_PER_HOUR=4
AUTOFINX_NEXUS_MAX_DEEP_CALLS_PER_DAY=1
AUTOFINX_NEXUS_DAILY_LLM_BUDGET_USD=1
AUTOFINX_NEXUS_MONTHLY_LLM_BUDGET_USD=15
AUTOFINX_NEXUS_INPUT_USD_PER_MILLION=0
AUTOFINX_NEXUS_OUTPUT_USD_PER_MILLION=0

# Quick Trade decision / timing / fee economics (config/quick_trade.php).
# Commented = the config default applies; uncomment only to override.
# Reject a LIVE order that disagrees with the fee-aware trade decision (paper never blocked).
# QUICK_TRADE_BLOCK_LIVE_AGAINST_DECISION=true
# Decide direction from CLOSED candles only (false restores the forming-bar behaviour).
# QUICK_TRADE_CLOSED_CANDLES_ONLY=true
# Grace after a candle close before the new decision is computable (feed jitter), ms.
# QUICK_TRADE_DECISION_CLOSE_GRACE_MS=1500
# Cache the Quick Trade decision until the next candle close (+ grace).
# QUICK_TRADE_DECISION_CLOSE_ANCHORED_CACHE=true
# Minimum chart candles inside the expiry for a LIVE trade (horizon_candles).
# QUICK_TRADE_MIN_HORIZON_CANDLES=3
# Enforce QUICK_TRADE_MIN_HORIZON_CANDLES on manual LIVE placements.
# QUICK_TRADE_ENFORCE_MIN_HORIZON_CANDLES=true
# Reject a chart timeframe longer than the expiry (both modes).
# QUICK_TRADE_REJECT_TIMEFRAME_ABOVE_EXPIRY=true
# LIVE expiries at/above this many seconds show the "no stop loss" warning.
# QUICK_TRADE_REQUIRE_STOP_LOSS_MIN_EXPIRY_SECONDS=1800
# When true, REJECT (422) such long LIVE trades without stop_loss_pct instead of only warning.
# QUICK_TRADE_ENFORCE_STOP_LOSS_MIN_EXPIRY=false
# Allow sub-15-minute expiries in LIVE mode (hidden by default: cannot clear the cost gate).
# QUICK_TRADE_ALLOW_SHORT_LIVE_EXPIRY=false
# Cost model for the fee-aware decision: taker | maker_entry (maker_entry is paper/shadow only).
# QUICK_TRADE_FEE_MODEL=taker
# Maker fee rate used by the maker_entry model.
# QUICK_TRADE_MAKER_FEE_RATE=0.0002
# Never let maker_entry drive a LIVE decision unless explicitly allowed.
# QUICK_TRADE_ALLOW_MAKER_ENTRY_IN_LIVE=false

# Quick Trade "Manual SL/TP" mode (config/quick_trade_manual.php). BOTH default OFF. UNVERIFIED on the exchange:
# keep QUICK_TRADE_MANUAL_ALLOW_MAINNET=false until docs/quick-trade-manual/TESTNET_CHECKLIST.md has been completed.
# A per-workspace flag (Setting group quick_trade_manual, key enabled) must ALSO be on.
# QUICK_TRADE_MANUAL_ENABLED=false
# QUICK_TRADE_MANUAL_ALLOW_MAINNET=false
# Allow trades WITHOUT a stop-loss (explicit per-trade opt-in still required). Keep false unless you will watch every trade.
# QUICK_TRADE_MANUAL_ALLOW_NO_STOP_LOSS=false
# QUICK_TRADE_MANUAL_NO_SL_MAX_LEVERAGE=5
# QUICK_TRADE_MANUAL_NO_SL_REQUIRE_ISOLATED=true
# Record untraded fee-aware WAITs (observation only; needs the 2026_09_30 wait_shadows migration).
# QUICK_TRADE_SHADOW_UNTRADED_WAITS=false
# Hypothetical USDT notional the untraded-WAIT outcomes are quoted on.
# QUICK_TRADE_SHADOW_UNTRADED_WAITS_REFERENCE_NOTIONAL_USDT=100
# Retention for quick_trade_wait_shadows rows, days (pruned by quick-trades:sample-research).
# QUICK_TRADE_SHADOW_UNTRADED_WAITS_RETENTION_DAYS=30
# Read-only Quick Trade research sampler (config/quick_trade_research.php, scheduled every 5s).
# QUICK_TRADE_RESEARCH_ENABLED=true

# Robot Trade / shared TradeForecastService cost gate (config/robot_trade.php).
# Shared by Quick Trade, Robot Trade and Ratio Bot's brain confirmation -- changes all three.
# Slippage buffer added to the live cost estimate, percent.
# ROBOT_TRADE_LIVE_SLIPPAGE_BUFFER_PCT=0.04
# Expected edge must exceed this multiple of cost (raised to 2x on 2026-09-23; lower reverses that fix).
# ROBOT_TRADE_LIVE_MIN_EDGE_COST_MULTIPLIER=2.0
# Minimum expected net profit after costs for a live entry, USDT.
# ROBOT_TRADE_LIVE_MIN_EXPECTED_NET_USDT=0.03
# Maximum drift between decision price and entry price, basis points.
# ROBOT_TRADE_MAX_ENTRY_PRICE_DRIFT_BPS=20.0
# Minimum live hold time, seconds.
# ROBOT_TRADE_LIVE_MIN_HOLD_SECONDS=60
# Fail-closed gate: live Robot Trade entries must agree with the fee-aware trade_decision (per-workspace override in settings).
# ROBOT_TRADE_BLOCK_LIVE_AGAINST_DECISION=false

# --- Quick Trade Python ML: Phase 1 shadow learning loop (config/ml.php) ---
# SHADOW ONLY: no order path reads any of this. Off by default; when true the
# scheduler runs candle sync, label maturation, shadow predictions, scoring and
# a daily retrain check (training itself runs on the queue below).
# AUTOFINX_ML_SHADOW_ENABLED=false
# AUTOFINX_ML_SYMBOLS=BTCUSDT,ETHUSDT
# AUTOFINX_ML_HORIZONS_MINUTES=15,60,240
# AUTOFINX_ML_PYTHON_BIN=/absolute/path/to/backends/external-predictive-engine/.venv/bin/python
# AUTOFINX_ML_TRAINING_QUEUE=ml_training
# AUTOFINX_ML_RETRAIN_SCHEDULE_UTC=03:05
# AUTOFINX_ML_MIN_TOTAL_MATURE_LABELS=20000
# AUTOFINX_ML_MIN_NEW_MATURE_LABELS=288
# AUTOFINX_ML_PREDICTOR_URL=http://127.0.0.1:8091
# AUTOFINX_ML_EVAL_MIN_SAMPLES=50
# AUTOFINX_ML_TRADE_FEEDBACK_MIN_ENTRY_AT=2026-09-25T13:35:00+05:30
# ML Training dashboard control plane (defaults shown)
# AUTOFINX_ML_TRAINING_STALL_SECONDS=180
# AUTOFINX_ML_TRAINING_AUTO_RETRY=true
# AUTOFINX_ML_TRAINING_MAX_ATTEMPTS=3
# AUTOFINX_ML_TRAINING_RETRY_BACKOFF_MINUTES=2,4,8
# AUTOFINX_ML_TRAINING_TIMEOUT_SECONDS=1800

# Strategy Lab (research only, SPEC §105). Tests need the V4 research data set (5-year Binance data); on a host
# without it (e.g. production) tests are refused with RUNNER_UNAVAILABLE. Worker: queue "strategy_lab" on the
# ml_training connection (php artisan queue:work ml_training --queue=strategy_lab --timeout=2400).
# AUTOFINX_STRATEGY_LAB_ENABLED=true
# AUTOFINX_STRATEGY_LAB_WORK_DIR=D:\autofinx-ml-v4
# AUTOFINX_STRATEGY_LAB_PYTHON_BIN=D:\autofinx-ml-v4\venv\Scripts\python.exe
# AUTOFINX_STRATEGY_LAB_QUICK_TIMEOUT=900
# AUTOFINX_STRATEGY_LAB_DEEP_TIMEOUT=2200

# Market Opportunity Brain V4 (research-only; all OFF by default). Heavy/temp data belongs on D:, not C:.
# AUTOFINX_MOB_PYTHON_BIN=D:\autofinx-mob-v4\venv\Scripts\python.exe
# AUTOFINX_MOB_HF_HOME=D:\autofinx-mob-v4\hf-cache
# AUTOFINX_MOB_HF_HUB_CACHE=D:\autofinx-mob-v4\hf-cache\hub
# AUTOFINX_MOB_PYTHON_TMP_DIR=D:\autofinx-mob-v4\tmp
# V5 research schedules remain OFF until explicitly enabled after operational review.
# AUTOFINX_V5_REFRESH_SCHEDULE_ENABLED=false
# AUTOFINX_V5_OUTCOME_SCHEDULE_ENABLED=false
