# Live trading safe mode
# LIVE_TRADING_ENABLED (below, near "Trading mode") gates the LEGACY spot
# execution path only (SafeLiveGate, TradingEnvironmentGuard,
# LivePromotionService, BinanceAdapter/CoinbaseAdapter) — it does NOT gate
# Future Trade (that's FUTURE_TRADE_ENABLE_LIVE_TRADING) or Fast2X (that's
# ENABLE_LIVE_TRADING). Three independent subsystems, three independent
# switches — flipping one does not affect the others.
LIVE_TRADING_REQUIRE_2FA=true
LIVE_TRADING_SYMBOL_ALLOWLIST=BTCUSDT,ETHUSDT
LIVE_TRADING_MAX_EXPOSURE_PCT=20
LIVE_TRADING_MAX_TRADE_PCT=2

# WebSockets / Reverb
# The real key Laravel reads is BROADCAST_CONNECTION (set above, under Redis
# config). BROADCAST_DRIVER is not read anywhere in this codebase — do not
# use it to control the broadcast driver, it does nothing.
REVERB_APP_ID=local
REVERB_APP_KEY=local
REVERB_APP_SECRET=local
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

