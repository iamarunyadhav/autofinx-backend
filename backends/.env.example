# AutoFinX runtime ownership
AUTOFINX_RUNTIME_OWNER=supervisor
AUTOFINX_SUPERVISOR_RUNTIME=true
# Bounded websocket transport: latest quote/open candle per scope is flushed
# every 100ms; closed candles bypass the buffer and persist immediately.
AUTOFINX_MARKET_TRANSPORT_FLUSH_INTERVAL_MS=100
AUTOFINX_LIVE_QUOTE_WRITE_INTERVAL_MS=100
AUTOFINX_LIVE_OPEN_CANDLE_WRITE_INTERVAL_MS=1000
AUTOFINX_LIVE_FEED_SIDE_EFFECT_INTERVAL_MS=1000

# Scheduler guards
# Each of these must have exactly ONE owner: either Laravel's own scheduler
# (this flag = true) or a dedicated Supervisor daemon (this flag = false).
# Production has been observed running BOTH for robot_sessions/quick_settler
# at once (AUTOFINX_PHASE1B_ARCHITECTURE_AUDIT_2026-09-02.md §6/§19) — always
# set the scheduler-side flag to false when a Supervisor daemon owns a role.
AUTOFINX_SCHEDULER_ENABLED=true
AUTOFINX_SCHEDULER_MARKET_CONSUMERS=false
AUTOFINX_SCHEDULER_BINANCE_REST=false
AUTOFINX_SCHEDULER_METALS=false
# Set to false wherever a dedicated Supervisor daemon (autofinx-robot-evaluator)
# owns Robot Trade evaluation instead.
AUTOFINX_SCHEDULER_ROBOT_SESSIONS=true
# Set to false wherever a dedicated Supervisor daemon (autofinx-quick-settler)
# owns Quick Trade settlement instead.
AUTOFINX_SCHEDULER_QUICK_SETTLER=true
AUTOFINX_SCHEDULER_RUNTIME_AUTO_REPAIR=true
AUTOFINX_SCHEDULER_RATIO_BOTS=true

# Future Trade scheduler modules
FUTURE_TRADE_SCHEDULE_RUNTIME_COMMANDS=false
FUTURE_TRADE_SCHEDULE_RECONCILE=false
FUTURE_TRADE_SCHEDULE_DIAGNOSTICS=false
FUTURE_TRADE_SCHEDULE_AUDIT_MISSED_SIGNALS=false

