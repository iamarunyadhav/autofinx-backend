PAYPAL_WEBHOOK_SECRET_LIVE=
PAYONEER_WEBHOOK_SECRET_SANDBOX=test_payoneer_signing_secret
PAYONEER_WEBHOOK_SECRET_LIVE=
STRIPE_SECRET_KEY_SANDBOX=test_stripe_secret
STRIPE_SECRET_KEY_LIVE=
STRIPE_CHECKOUT_SUCCESS_URL_SANDBOX=http://localhost:8080/wallet
STRIPE_CHECKOUT_CANCEL_URL_SANDBOX=http://localhost:8080/wallet
STRIPE_CHECKOUT_SUCCESS_URL_LIVE=
STRIPE_CHECKOUT_CANCEL_URL_LIVE=
