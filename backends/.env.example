PAYPAL_CLIENT_SECRET_SANDBOX=test_paypal_secret
PAYPAL_CLIENT_ID_LIVE=
PAYPAL_CLIENT_SECRET_LIVE=
PAYONEER_PROGRAM_ID_SANDBOX=test_program
PAYONEER_USERNAME_SANDBOX=test_user
PAYONEER_PASSWORD_SANDBOX=test_pass
PAYONEER_CHECKOUT_URL_SANDBOX=
PAYONEER_PROGRAM_ID_LIVE=
PAYONEER_USERNAME_LIVE=
PAYONEER_PASSWORD_LIVE=
PAYONEER_CHECKOUT_URL_LIVE=
BANK_PAYOUT_URL_SANDBOX=http://localhost:3000/mock-bank
BANK_PAYOUT_KEY_SANDBOX=bank_sandbox_key
BANK_PAYOUT_URL_LIVE=
BANK_PAYOUT_KEY_LIVE=

# Billing / Gateway router
BILLING_ENABLED=true
GATEWAY_DEFAULT=payhere

PAYHERE_ENABLED=false
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_RETURN_URL=http://localhost:3000/billing/return/payhere
PAYHERE_CANCEL_URL=http://localhost:3000/billing/cancel/payhere
PAYHERE_NOTIFY_URL=http://localhost:8000/api/v1/billing/webhook/payhere

PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

PAYONEER_ENABLED=true
STRIPE_ENABLED=false
STRIPE_WEBHOOK_URL=http://localhost:8000/api/v1/wallet/stripe/webhook

# Wallet rules
WALLET_MIN_TOPUP=5
WALLET_MAX_WITHDRAW=5000
WITHDRAWALS_REQUIRE_APPROVAL=true

# Live trading safe mode
# LIVE_TRADING_ENABLED (below, near "Trading mode") gates the LEGACY spot
# execution path only (SafeLiveGate, TradingEnvironmentGuard,
# LivePromotionService, BinanceAdapter/CoinbaseAdapter) — it does NOT gate
# Future Trade (that's FUTURE_TRADE_ENABLE_LIVE_TRADING) or Fast2X (that's
# ENABLE_LIVE_TRADING). Three independent subsystems, three independent
# switches — flipping one does not affect the others.
LIVE_TRADING_REQUIRE_2FA=true
LIVE_TRADING_SYMBOL_ALLOWLIST=BTCUSDT,ETHUSDT
LIVE_TRADING_MAX_EXPOSURE_PCT=20
LIVE_TRADING_MAX_TRADE_PCT=2

# WebSockets / Reverb
# The real key Laravel reads is BROADCAST_CONNECTION (set above, under Redis
# config). BROADCAST_DRIVER is not read anywhere in this codebase — do not
# use it to control the broadcast driver, it does nothing.
REVERB_APP_ID=local
REVERB_APP_KEY=local
REVERB_APP_SECRET=local
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Assistant
ASSISTANT_ENABLED=true
ASSISTANT_VOICE_ENABLED=false
ASSISTANT_TOOL_ALLOWLIST=get_portfolio_summary,explain_last_trade,change_strategy_param,toggle_strategy,generate_strategy_code
AI_BRAIN_ENABLED=false
AI_BRAIN_PROVIDER=openai
AI_BRAIN_TIMEOUT_MS=3500
AI_MODE=ADVISORY
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_MODEL=claude-opus-4-8

# AI trading middleware
AI_TRADE_SCHEDULE_ENABLED=false
AI_TRADE_PROVIDER=heuristic
AI_TRADE_PROPOSAL_EXPIRY_MINUTES=15
AI_TRADE_QUOTE_CURRENCY=USDT
AI_TRADE_OPENAI_API_KEY=
AI_TRADE_OPENAI_API_URL=https://api.openai.com/v1/chat/completions
AI_TRADE_OPENAI_MODEL=gpt-4.1-mini
AI_TRADE_OPENAI_TIMEOUT_MS=5000
AI_TRADE_GEMINI_API_KEY=
AI_TRADE_GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
AI_TRADE_GEMINI_MODEL=gemini-1.5-flash
AI_TRADE_GEMINI_TIMEOUT_MS=5000
AI_TRADE_ANTHROPIC_API_KEY=
AI_TRADE_ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
AI_TRADE_ANTHROPIC_MODEL=claude-opus-4-8
AI_TRADE_ANTHROPIC_TIMEOUT_MS=10000
AI_TRADE_HEURISTIC_MIN_CONFIDENCE=0.55
AI_TRADE_HEURISTIC_STRONG_CONFIDENCE=0.65
AI_TRADE_HEURISTIC_RSI_BUY_CEILING=68
AI_TRADE_HEURISTIC_RSI_SELL_FLOOR=32
AI_TRADE_HEURISTIC_STOP_LOSS_PCT=0.8
AI_TRADE_HEURISTIC_TAKE_PROFIT_PCT=1.6
AI_TRADE_HEURISTIC_TIME_STOP_MINUTES=90

# Exchange sync scheduler (cron expression)
EXCHANGE_SYNC_CRON=*/10 * * * *

# Risk & Kill-switch
RISK_KILL_SWITCH=false
RISK_MAX_DAILY_LOSS=2500
RISK_MAX_DRAWDOWN_PERCENT=20
RISK_CONN_FRESH_MINUTES=15
MAINTENANCE_UNTIL=
FAILED_ORDER_RETRY_LIMIT=2

# Security / 2FA
ENFORCE_2FA_CRITICAL=true
ENFORCE_2FA_LOGIN=true
SMS_WEBHOOK_URL=
SMS_WEBHOOK_KEY=
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_KEY=

# Demo / Trading loop
DEMO_MODE=true
DEMO_MARKET_ENABLED=true
DEMO_MARKET_SYMBOLS=BTCUSDT,ETHUSDT,AAPL
DEMO_MARKET_TICK_INTERVAL_SECONDS=2

TRADING_LOOP_ENABLED=true
TRADING_LOOP_INTERVAL_SECONDS=300
SCHEDULER_DEFAULT_TIMEZONE=Asia/Colombo

# Trading mode
# LIVE_TRADING_ENABLED gates the LEGACY spot execution path only (see the
# "Live trading safe mode" section above for the full explanation of why
# this is NOT a global kill switch for Future Trade or Fast2X).
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false

# Exchange adapters
EXCHANGE_DEFAULT=binance
# BINANCE_ENABLED only gates the legacy Adapters/BinanceAdapter.php spot
# adapter (paired with LIVE_TRADING_ENABLED above) — it does not gate Ratio
# Bot, Future Trade, Fast2X, or Robot Trade's own Binance usage.
BINANCE_ENABLED=false
BINANCE_API_KEY=
BINANCE_API_SECRET=
# BINANCE_API_URL is the only key actually read (config/services.php ->
# services.binance.api_url / services.binance.base_url). A separate
# BINANCE_BASE_URL key used to exist here and was read raw via env() in
# BinanceAdapter.php, bypassing `php artisan config:cache` — removed; do not
# reintroduce it.
BINANCE_API_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443
BINANCE_TESTNET_API_URL=https://testnet.binance.vision
BINANCE_TESTNET_WS_URL=wss://testnet.binance.vision
BINANCE_FUTURES_API_URL=https://fapi.binance.com
BINANCE_FUTURES_WS_URL=wss://fstream.binance.com
BINANCE_FUTURES_WS_API_URL=wss://ws-fapi.binance.com/ws-fapi/v1
BINANCE_FUTURES_TESTNET_API_URL=https://testnet.binancefuture.com
BINANCE_FUTURES_TESTNET_WS_URL=wss://stream.binancefuture.com
BINANCE_FUTURES_TESTNET_WS_API_URL=wss://testnet.binancefuture.com/ws-fapi/v1
BINANCE_FUTURES_LIVE_API_KEY=
BINANCE_FUTURES_LIVE_API_SECRET=
BINANCE_FUTURES_TESTNET_API_KEY=
BINANCE_FUTURES_TESTNET_API_SECRET=
USER_STREAM_INGEST_TOKEN=
BINANCE_USER_STREAM_KEEPALIVE_SEC=1800
FUTURE_TRADE_ORDER_TRANSPORT=rest
FUTURE_TRADE_ORDER_WEBSOCKET_ENABLED=false
FUTURE_TRADE_ORDER_WEBSOCKET_TIMEOUT_SECONDS=8
WITHDRAW_WEBHOOK_TOKEN=

# Sweep bridge defaults
SWEEP_AUTO_ENABLED=true
SWEEP_DEFAULT_MIN_AMOUNT=10

# Live bot worker defaults
MARKET_WS_SYMBOLS=BTCUSDT,ETHUSDT
BOT_EVALUATE_LIMIT=200

# AutoFinX runtime ownership
AUTOFINX_RUNTIME_OWNER=supervisor
AUTOFINX_SUPERVISOR_RUNTIME=true
# Bounded websocket transport: latest quote/open candle per scope is flushed
# every 100ms; closed candles bypass the buffer and persist immediately.
AUTOFINX_MARKET_TRANSPORT_FLUSH_INTERVAL_MS=100
AUTOFINX_LIVE_QUOTE_WRITE_INTERVAL_MS=100
AUTOFINX_LIVE_OPEN_CANDLE_WRITE_INTERVAL_MS=1000
AUTOFINX_LIVE_FEED_SIDE_EFFECT_INTERVAL_MS=1000

# Scheduler guards
# Each of these must have exactly ONE owner: either Laravel's own scheduler
# (this flag = true) or a dedicated Supervisor daemon (this flag = false).
# Production has been observed running BOTH for robot_sessions/quick_settler
# at once (AUTOFINX_PHASE1B_ARCHITECTURE_AUDIT_2026-09-02.md §6/§19) — always
# set the scheduler-side flag to false when a Supervisor daemon owns a role.
AUTOFINX_SCHEDULER_ENABLED=true
AUTOFINX_SCHEDULER_MARKET_CONSUMERS=false
AUTOFINX_SCHEDULER_BINANCE_REST=false
AUTOFINX_SCHEDULER_METALS=false
# Set to false wherever a dedicated Supervisor daemon (autofinx-robot-evaluator)
# owns Robot Trade evaluation instead.
AUTOFINX_SCHEDULER_ROBOT_SESSIONS=true
# Set to false wherever a dedicated Supervisor daemon (autofinx-quick-settler)
# owns Quick Trade settlement instead.
AUTOFINX_SCHEDULER_QUICK_SETTLER=true
AUTOFINX_SCHEDULER_RUNTIME_AUTO_REPAIR=true
AUTOFINX_SCHEDULER_RATIO_BOTS=true

# Future Trade scheduler modules
FUTURE_TRADE_SCHEDULE_RUNTIME_COMMANDS=false
FUTURE_TRADE_SCHEDULE_RECONCILE=false
FUTURE_TRADE_SCHEDULE_DIAGNOSTICS=false
FUTURE_TRADE_SCHEDULE_AUDIT_MISSED_SIGNALS=false

# Future Trade live execution source
# (moved into the "Future Trade Bot" block below to fix a literal duplicate
# key — FUTURE_TRADE_PINE_WEBHOOK_LIVE_ENABLED and
# FUTURE_TRADE_PRIME_MIRROR_LIVE_ENABLED were each defined twice in this
# file; harmless today since both copies agreed, but a future edit to only
# one occurrence would have silently done nothing)

# Binance REST safety
BINANCE_REST_CIRCUIT_BREAKER=true
BINANCE_REST_MIN_INTERVAL_MS=500
BINANCE_REST_BAN_COOLDOWN_SECONDS=3600

# Multi-asset / metals
METALS_ENABLED=true
METALS_DEFAULT_PROVIDER=metal_broker
METALS_SYMBOLS=XAUUSD,XAGUSD,XCUUSD
METALS_POLL_INTERVAL_SEC=5
METAL_BROKER_MODE=sandbox
METAL_BROKER_API_URL=
METAL_BROKER_API_KEY=
METAL_BROKER_API_SECRET=
METAL_BROKER_ORDER_PATH=/v1/orders
METAL_BROKER_STATUS_PATH=/v1/orders/{order_id}
METAL_BROKER_BALANCES_PATH=/v1/account/balances
METAL_BROKER_PRICE_PATH=/v1/quotes/{asset_code}
METAL_BROKER_SUPPORTS_IOC=false
METAL_BROKER_DEFAULT_SPREAD_PCT=0.4

# FX conversion
FX_DEFAULT_USD_LKR=315
FX_RATE_PROVIDER=openexchangerates
FX_RATE_API_URL=
FX_RATE_API_KEY=
FX_RATE_TTL_SEC=120

COINBASE_ENABLED=false
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_BASE_URL=https://api.coinbase.com

# Risk defaults
RISK_DEFAULT_MAX_TRADE_PCT=2
RISK_DEFAULT_MAX_POSITION_PCT=10
RISK_DEFAULT_DAILY_LOSS_PCT=5
RISK_DEFAULT_DRAWDOWN_PCT=10
RISK_DEFAULT_SLIPPAGE_BPS=50
RISK_DEFAULT_VOLATILITY_BPS=250

# Fees (paper)
PAPER_FEE_BPS=10

# Fast2X micro scalping bot
# BINANCE_TESTNET is not read anywhere in this codebase — removed. Fast2X's
# real testnet/live switch is PAPER_TRADING + ENABLE_LIVE_TRADING below.
PAPER_TRADING=true
# ENABLE_LIVE_TRADING gates Fast2X only (config/fast2x.php). It is NOT the
# same switch as LIVE_TRADING_ENABLED (legacy spot) or
# FUTURE_TRADE_ENABLE_LIVE_TRADING (Future Trade) — see "Live trading safe
# mode" above.
ENABLE_LIVE_TRADING=false
FAST2X_DEFAULT_SYMBOL=BTCUSDT
FAST2X_MAX_LATENCY_MS=500
FAST2X_POLLING_INTERVAL_MS=1000
FAST2X_WEBSOCKET_RETRY_SECONDS=30
FAST2X_MAX_TRADES_PER_DAY=50
FAST2X_MAX_DAILY_LOSS_PERCENT=3
# Seconds fast2x_states.last_heartbeat_at may go stale before fast2x:supervise
# (scheduled every minute, routes/console.php) restarts that workspace's
# fast2x:run daemon. See app/Console/Commands/Fast2XSuperviseCommand.php.
FAST2X_SUPERVISOR_STALE_SECONDS=90
# Leave blank to auto-detect (PHP_BINARY, then common cPanel ea-phpXX paths).
FAST2X_PHP_BINARY=

# Future Trade Bot - futures scanner/execution
FUTURE_TRADE_PAPER_TRADING=true
FUTURE_TRADE_ENABLE_TESTNET_TRADING=false
# FUTURE_TRADE_ENABLE_LIVE_TRADING gates Future Trade only. It is NOT the
# same switch as LIVE_TRADING_ENABLED (legacy spot) or ENABLE_LIVE_TRADING
# (Fast2X) — see "Live trading safe mode" above. As of the 2026-09-02 audit
# fix, this server-level flag is AND-ed with the per-workspace DB flag in
# FutureTradeBotService::environmentTradingEnabled() — both must be true for
# live trading to proceed, so setting this to false here is a real global
# block regardless of what any individual workspace has configured.
FUTURE_TRADE_ENABLE_LIVE_TRADING=false
FUTURE_TRADE_FORCE_TESTNET=true
FUTURE_TRADE_DEFAULT_SIGNAL_PROFILE=autofinx_prime_v6_1_7_crypto
FUTURE_TRADE_SIGNAL_PROFILE=autofinx_prime_v6_1_7_crypto
FUTURE_TRADE_PHP_BINARY=
FUTURE_TRADE_PINE_WEBHOOK_TOKEN=
FUTURE_TRADE_PRIME_MIRROR_EXECUTION_ENABLED=false
FUTURE_TRADE_PRIME_MIRROR_LIVE_ENABLED=false
FUTURE_TRADE_PINE_WEBHOOK_LIVE_ENABLED=true

# Audit Research observability subsystem (Ratio Bot). When false,
# AuditEventRecorder::record() is a true no-op before any DB work — safe to
# flip off without affecting Ratio Bot's own trading behavior.
AUDIT_RESEARCH_ENABLED=true
FUTURE_TRADE_PERMISSIVE_SYMBOL_MODE=true
FUTURE_TRADE_PINE_WEBHOOK_FALLBACK_TIMEOUT_SECONDS=1200

# Per-asset toggles
ASSET_GLOBAL_ENABLED=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Nexus research: install migrations and isolated workers before enabling.
AUTOFINX_NEXUS_ENABLED=false
AUTOFINX_NEXUS_AUTONOMY_LEVEL=2
AUTOFINX_NEXUS_QUEUE_CONNECTION=nexus
AUTOFINX_NEXUS_LLM_ENABLED=false
AUTOFINX_NEXUS_LLM_PROVIDER=openai-compatible
AUTOFINX_NEXUS_LLM_URL=
AUTOFINX_NEXUS_LLM_API_KEY=
AUTOFINX_NEXUS_ROUTINE_MODEL=
AUTOFINX_NEXUS_DEEP_MODEL=
AUTOFINX_NEXUS_MAX_CALLS_PER_HOUR=4
AUTOFINX_NEXUS_MAX_DEEP_CALLS_PER_DAY=1
AUTOFINX_NEXUS_DAILY_LLM_BUDGET_USD=1
AUTOFINX_NEXUS_MONTHLY_LLM_BUDGET_USD=15
AUTOFINX_NEXUS_INPUT_USD_PER_MILLION=0
AUTOFINX_NEXUS_OUTPUT_USD_PER_MILLION=0
