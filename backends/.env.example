DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Production recommendation:
# QUEUE_CONNECTION=redis
# This is only a documented fallback example — the intended real owner of
# the ratio_bot queue is a dedicated autofinx-queue-ratio Supervisor worker,
# not this broad command. If this broad command is ever used as a fallback,
# include ratio_bot explicitly or Ratio Bot evaluations will never run.
QUEUE_WORKER_COMMAND="php artisan queue:work redis --queue=critical,execution,market,signals,ops,intelligence,risk,analytics,notifications,default,ratio_bot --sleep=1 --tries=3 --timeout=120 --max-time=3600"
QUEUE_DASHBOARD_ALLOW_CLEAR=true
# The laravel/horizon package is NOT installed in this app. HORIZON_ENABLED
# only drives a UI status flag (class_exists()-gated, see
# app/Domain/Ops/QueueControlService.php) — it cannot actually start Horizon.
# Keep this false unless the package is installed.
HORIZON_ENABLED=false
OPS_QUEUE_BACKLOG_WARNING=100
OPS_QUEUE_BACKLOG_BLOCK=500

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

