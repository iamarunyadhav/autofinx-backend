AUTOFINX_PREDICTOR_HOST=127.0.0.1
AUTOFINX_PREDICTOR_PORT=8091
AUTOFINX_PREDICTOR_PROVIDER=lightgbm
AUTOFINX_PREDICTOR_MODEL_PATH=
AUTOFINX_PREDICTOR_MODEL_DIR=/absolute/path/to/backends/storage/app/prediction-fresh-shadow-models
AUTOFINX_PREDICTOR_LOG_LEVEL=INFO
# Quick Trade ML shadow champions published by Laravel (config ml.training.champion_dir).
AUTOFINX_PREDICTOR_SHADOW_DIR=/absolute/path/to/backends/storage/app/ml-shadow/champions
